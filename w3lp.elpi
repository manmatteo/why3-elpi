

% Embedding of type symbols. Internal information (Ident, arguments) is
% not exposed.
kind tysymbol type.

external symbol arr : tysymbol = "1".

% Embedding of type variables. Internal information (Ident, arguments) is
% not exposed.
kind tvsymbol type.


% ctx_for_ty
kind ctx-for-ty type.
external symbol ctx-tv : ty -> tvsymbol -> prop.
% Ctx_tv

% why_simple_ty
kind ty type.
external symbol tyapp : tysymbol -> (list ty) -> ty.
% Tyapp
external symbol tyabs : tvsymbol -> (ty -> ty) -> ty.
% Tyabs

% Embedding of variable symbols
kind var type.


% Embedding of predicate symbols. Name, argument and value type can be
% accessed via native predicates.
kind lsymbol type.

external symbol infix_at : lsymbol = "1".

% Names for declarations
kind prsymbol type.


% Embedding of Why3 constants
kind constant type.


% quant
kind quant type.
external symbol tforall : quant.
% Tforall
external symbol texists : quant.
% Texists

% binop
kind binop type.
external symbol tand : binop.
% Tand
external symbol tor : binop.
% Tor
external symbol timplies : binop.
% Timplies
external symbol tiff : binop.
% Tiff

% Why3 attributes, embedded structurally: (attr S) is the attribute with string representation S.
kind attribute type.
external symbol attr : string -> attribute.
% Attr

% ctx_for_term
kind ctx-for-term type.
external symbol ctx-vs : term -> var -> prop.
% Ctx_vs

% ctx_for_lsymbol
kind ctx-for-lsymbol type.
external symbol ctx-ls : term -> lsymbol -> prop.
% Ctx_ls

% Pattern constructors for pattern-matching terms. Use pvar to name pattern-bound variables and babs to bind their body occurrences.
kind pattern type.
external symbol pwild : pattern.
% Pwild
external symbol pvar : var -> pattern.
% Pvar
external symbol papp : lsymbol -> (list pattern) -> pattern.
% Papp
external symbol por : pattern -> pattern -> pattern.
% Por
external symbol pas : pattern -> var -> pattern.
% Pas

% Case branches. Use babs to bind pattern variables, then branch to pair the pattern with its body.
kind branch type.
external symbol branch : pattern -> term -> branch.
% Branch
external symbol babs : var -> (term -> branch) -> branch.
% Babs

% Why3 terms. Use tattr to attach attributes to a subterm. Pattern-matching uses branch/babs HOAS branches, applications have optional type annotations, and quantifier triggers use an explicit ttrigger carrier directly under the quantifier body.
kind term type.
external symbol tattr : (list attribute) -> term -> term.
% Tattr
external symbol tconst : constant -> ty -> term.
% Tconst
external symbol tapp : lsymbol -> (list term) -> (option ty) -> term.
% Tapp
external symbol tlet : term -> var -> (term -> term) -> term.
% Tlet
external symbol ttrigger : (list (list term)) -> term -> term.
% Ttrigger
external symbol tquant : quant -> var -> (term -> term) -> term.
% Tquant
external symbol teps : var -> (term -> term) -> term.
% Teps
external symbol ttrue : term.
% Ttrue
external symbol tfalse : term.
% Tfalse
external symbol tbinop : binop -> term -> term -> term.
% Tbinop
external symbol tif : term -> term -> term -> term.
% Tif
external symbol tnot : term -> term.
% Tnot
external symbol tcase : term -> (list branch) -> term.
% Tcase

% Opened declaration bodies. Use dabs for definition parameters and dterm for the final body term.
kind decl_body type.
external symbol dterm : term -> decl_body.
% Dterm
external symbol dabs : var -> (term -> decl_body) -> decl_body.
% Dabs

% Local symbol declarations. Use symbol-param for an uninterpreted local symbol and symbol-logic for a defined local body.
kind local-symbol-decl type.
external symbol symbol-param : local-symbol-decl.
% Symbol_param
external symbol symbol-logic : decl_body -> local-symbol-decl.
% Symbol_logic

% Focused Why3 goal: a goal formula together with its original goal symbol, plus optional local symbol declarations, local proposition declarations, and local type declarations to reify as declarations during readback.
kind focused-goal type.
external symbol goal-formula : prsymbol -> term -> focused-goal.
% Goal_formula
external symbol local-symbol : lsymbol -> (term -> local-symbol-decl) -> (term -> focused-goal) -> focused-goal.
% Local_symbol
external symbol local-prop : string -> term -> focused-goal -> focused-goal.
% Local_prop
external symbol local-type : tysymbol -> focused-goal -> focused-goal.
% Local_type

% References to Why3 global symbols defined by declarations.
kind gref type.
external symbol gpr : prsymbol -> gref.
% Gpr
external symbol gls : lsymbol -> gref.
% Gls
external symbol gty : tysymbol -> gref.
% Gty

% Classification of Why3 declarations returned by why3.decl-kind.
kind decl-kind type.
external symbol decl-prop : decl-kind.
% Decl_prop
external symbol decl-type : decl-kind.
% Decl_type
external symbol decl-data : decl-kind.
% Decl_data
external symbol decl-ind : decl-kind.
% Decl_ind
external symbol decl-logic : decl-kind.
% Decl_logic
external symbol decl-param : decl-kind.
% Decl_param

% Opaque Why3 declaration. Inspect it with why3.decl-kind,
% why3.decl-defines, and why3.decl-body.
kind decl type.


% Symbol for theory (currently cannot be inspected)
kind theory type.


% Symbol for meta args (currently cannot be inspected)
kind meta-arg type.


% Symbol for meta (currently cannot be inspected)
kind meta type.


% tdecl
kind tdecl type.
external symbol decl : decl -> tdecl.
% Decl
external symbol use : theory -> tdecl.
% Use
external symbol meta : meta -> (list meta-arg) -> tdecl.
% Meta
external symbol clone : meta-arg -> tdecl.
% Clone of a theory (opaque)

kind focused-task type.
external symbol focused-task : list tdecl -> focused-goal -> focused-task.

% The current environment can be retrieved, for example during a
% transformation with why3.get-env
kind env type.


% [why3.mk-var Name T V] Create a fresh Why3 variable symbol from a printed
% name and type.
external func why3.mk-var string, ty -> var.

% [why3.mk-tv Name Tv] Create a fresh Why3 type variable symbol from a
% printed name.
external func why3.mk-tv string -> tvsymbol.

% [why3.mk-ts Name TvArgs Ts] Create a fresh abstract type symbol with the
% given name and type-variable arguments. Pass [] for a monomorphic
% (arity-0) type symbol.
external func why3.mk-ts string, list tvsymbol -> tysymbol.

% [why3.mk-ls Name Args Result Ls] Create a fresh Why3 logic symbol. When
% Result is (some T) creates a function symbol with return type T; when
% Result is none creates a predicate symbol (ls_value = None).
external func why3.mk-ls string, list ty, option ty -> lsymbol.

% [why3.var-name V Name] Project the printed name of a variable symbol.
external func why3.var-name var -> string.

% [why3.var-attrs V Attrs] Project the attributes attached to a variable
% symbol.
external func why3.var-attrs var -> list attribute.

% [why3.prsymbol-name Pr Name] Project the printed name of a proposition
% symbol.
external func why3.prsymbol-name prsymbol -> string.

% [why3.prsymbol-attrs Pr Attrs] Project the attributes attached to a
% proposition symbol.
external func why3.prsymbol-attrs prsymbol -> list attribute.

% [why3.ls-name Ls Name] Project the printed name of a logic symbol.
external func why3.ls-name lsymbol -> string.

% [why3.ls-attrs Ls Attrs] Project the attributes attached to a logic
% symbol.
external func why3.ls-attrs lsymbol -> list attribute.

% [why3.ls-args Ls Args] Return the argument types of a logic symbol.
external func why3.ls-args lsymbol -> list ty.

% [why3.tysymbol-name Ts Name] Project the printed name of a type symbol.
external func why3.tysymbol-name tysymbol -> string.

% [why3.tysymbol-attrs Ts Attrs] Project the attributes attached to a type
% symbol.
external func why3.tysymbol-attrs tysymbol -> list attribute.

% [why3.ts-args Ts TvArgs] Return the type variable arguments (ts_args) of a
% type symbol.
external func why3.ts-args tysymbol -> list tvsymbol.

% [why3.tv-name Tv Name] Project the printed name of a type variable symbol.
external func why3.tv-name tvsymbol -> string.

% [why3.tv-attrs Tv Attrs] Project the attributes attached to a type
% variable symbol.
external func why3.tv-attrs tvsymbol -> list attribute.

% [why3.var-type V T] Get the type of a variable
external func why3.var-type var -> ty.

% [why3.ls-type L T] Get the value type of a logic symbol. Fails if the
% symbol has no value type (i.e. is a proposition)
external func why3.ls-type lsymbol -> ty.

% [why3.attr S Attr] Create a Why3 attribute from its string representation.
external func why3.attr string -> attribute.

% [why3.attr-string Attr S] Project the string representation of a Why3
% attribute.
external func why3.attr-string attribute -> string.

% [why3.decl-kind D K] Classify a declaration.
external func why3.decl-kind decl -> decl-kind.

% [why3.decl-defines D Refs] Enumerate the global references defined by a
% declaration.
external func why3.decl-defines decl -> list gref.

% [why3.decl-body D Ref Body] Project the opened body attached to a
% declaration/reference pair. Succeeds for proposition declarations and
% defined logic symbols.
external func why3.decl-body decl, gref -> decl_body.

% [why3.pp-decl D S] Pretty-print a declaration.
external func why3.pp-decl decl -> string.

% [why3.pp-tdecl TD S] Pretty-print a task declaration.
external func why3.pp-tdecl tdecl -> string.

% [why3.pp-theory Th S] Pretty-print a theory symbol.
external func why3.pp-theory theory -> string.

% [why3.pp-meta M S] Pretty-print a meta symbol.
external func why3.pp-meta meta -> string.

% [why3.pp-meta-arg A S] Pretty-print a meta argument.
external func why3.pp-meta-arg meta-arg -> string.

% [why3.pp-term T S] Convert a term to string using Why3's pretty printer
external func why3.pp-term term -> string.

% [why3.pp-ty T S] Convert a type to string using Why3's pretty printer.
external func why3.pp-ty ty -> string.

% [why3.ls-full-type Ls Ty] Get the full arrow type of a logic symbol: arg1
% -> ... -> argN -> result. Fails for predicates (no value type).
external func why3.ls-full-type lsymbol -> ty.

% [why3.decl-data-constructors D Ctors] If D is a Ddata declaration, return
% the list of (constructor, projections) pairs. Each projection list entry
% is none if the field has no projection function, or some Proj otherwise.
% Fails if D is not a Ddata declaration.
external func why3.decl-data-constructors decl -> list (pair lsymbol (list (option lsymbol))).

% Convenience macros for working with the focused-goal API.


% [w3-ls-of-var! V Ls] Allocate a fresh lsymbol whose name and type are taken
% from variable symbol V. Shorthand for the three-step
%   why3.var-name V Name, why3.var-type V Ty, why3.mk-ls Name [] (some Ty) Ls
% preamble needed before introducing a local constant.
macro @w3-ls-of-var! V Ls :-
  why3.var-name V Name, why3.var-type V Ty, why3.mk-ls Name [] (some Ty) Ls.



% [@pi-local-param! Ls GoalOut Next F] Build a local-symbol node for the
% uninterpreted constant Ls, bind a fresh ELPI nominal `x` for it in
% ctx-ls, and evaluate F x.  GoalOut is unified with the focused-goal wrapper
% and Next is the continuation binder.  Mirrors the coq-elpi @pi-decl macro.
%
% Typical usage for opening a forall as a local parameter:
%
%   inspect GoalPr (tquant tforall V Bnd) GoalOut :-
%     @w3-ls-of-var! V Ls,
%     @pi-local-param! Ls GoalOut Next (x\
%       inspect GoalPr (Bnd (tapp Ls [] none)) (Next x)).
macro @pi-local-param! Ls GoalOut Next F :-
  GoalOut = local-symbol Ls (_\ symbol-param) Next,
  pi x\ ctx-ls x Ls => F x.



% [@pi-local-param-goal! Ls GoalOut F] Same as @pi-local-param!, but hides
% the continuation binder from the caller. F receives InnerGoal: the
% focused-goal hole to fill under the local-symbol wrapper.
%
% Note: `x` is a context token for ctx-ls lookup, not a term to embed.
% To open a binder body, keep using (tapp Ls [] none).
%
% Typical usage:
%
%   @pi-local-param-goal! Ls GoalOut (InnerGoal\
%     inspect GoalPr (Bnd (tapp Ls [] none)) InnerGoal).
macro @pi-local-param-goal! Ls GoalOut F :-
      GoalOut = local-symbol Ls (_\ symbol-param) (x\ Inner x),
      pi x\ ctx-ls x Ls => F (Inner x).



% [@open-forall-local-param! V Bnd GoalOut F] Open a forall binder as a
% local-symbol parameter in one step. F receives:
% - Body: the binder body opened as Bnd (tapp Ls [] none)
% - InnerGoal: the focused-goal hole under the local-symbol wrapper.
%
% If you also need access to the freshly allocated lsymbol itself, use
% @w3-ls-of-var! followed by @pi-local-param-goal! directly.
%
% Typical usage:
%
%   @open-forall-local-param! V Bnd GoalOut (Body\ InnerGoal\
%     inspect GoalPr Body InnerGoal).
macro @open-forall-local-param! V Bnd GoalOut F :-
  @w3-ls-of-var! V Ls,
  @pi-local-param-goal! Ls GoalOut (InnerGoal\
    F (Bnd (tapp Ls [] none)) InnerGoal).


external symbol w3_run : prsymbol -> list term -> list tdecl -> focused-goal -> list focused-task -> prop.




