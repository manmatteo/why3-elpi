%% API for manipulating Why3 terms and declaration via λProlog
%% This file is automatically generated.

% Embedding of type symbols. Internal information (Ident, arguments) is
% not exposed.
typeabbrev tysymbol (ctype "tysymbol").

type arr tysymbol.

% Embedding of type variables. Internal information (Ident, arguments) is
% not exposed.
typeabbrev tvsymbol (ctype "tvsymbol").


% why_simple_ty
kind ty type.
type tyvar tvsymbol -> ty. % Tyvar
type tyapp tysymbol -> list ty -> ty. % Tyapp

% Embedding of variable symbols
typeabbrev var (ctype "var").


% Embedding of predicate symbols. Name, argument and value type can be
% accessed via native predicates.
typeabbrev lsymbol (ctype "lsymbol").

type infix_at lsymbol.

% quant
kind quant type.
type tforall quant. % Tforall
type texists quant. % Texists

% binop
kind binop type.
type tand binop. % Tand
type tor binop. % Tor
type timplies binop. % Timplies
type tiff binop. % Tiff

% ctx_for_term
kind ctx-for-term type.
type dctx-vs nominal -> var -> lsymbol -> prop. % Dctx_vs

% Pattern constructors for pattern-matching terms.
kind pattern type.
type pwild pattern. % Pwild
type pvar var -> pattern. % Pvar
type papp lsymbol -> list pattern -> pattern. % Papp
type por pattern -> pattern -> pattern. % Por
type pas pattern -> var -> pattern. % Pas

% why_simple_term
kind term type.
type tint int -> term. % Tint
type tapp lsymbol -> list term -> term. % Tapp
type tquant quant -> var -> (term -> term) -> term. % Tquant
type teps var -> (term -> term) -> term. % Teps
type ttrue term. % Ttrue
type tfalse term. % Tfalse
type tbinop binop -> term -> term -> term. % Tbinop
type tnot term -> term. % Tnot
type tcase term -> ty -> list (pair pattern term) -> term. % Tcase
type pabs var -> (term -> term) -> term. % Pabs

% Names for declarations
typeabbrev prsymbol (ctype "prsymbol").


type logic  lsymbol  -> term -> logic_decl.
typeabbrev data_decl (ctype "data_decl").


kind decl type.
type goal   prsymbol -> term -> decl.
type lemma  prsymbol -> term -> decl.
type axiom  prsymbol -> term -> decl.
type typ    tysymbol -> decl. % Abstract type
type data   list data_decl   -> decl. % Data (defined) type
type declls list logic_decl  -> decl. % Defined logic symbol
type const  lsymbol  -> decl.
% Symbol for theory (currently cannot be inspected)
typeabbrev theory (ctype "theory").


% Symbol for meta args (currently cannot be inspected)
typeabbrev meta-arg (ctype "meta-arg").


% Symbol for meta (currently cannot be inspected)
typeabbrev meta (ctype "meta").


% tdecl
kind tdecl type.
type decl decl -> tdecl. % Decl
type use theory -> tdecl. % Use
type meta meta -> list meta-arg -> tdecl. % Meta

% The current environment can be retrieved, for example during a
% transformation with why3.get-env
typeabbrev env (ctype "env").





