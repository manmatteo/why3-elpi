axiom Inv_def_l : forall x:int. infix_pl (prefix_mn x) x = zero

axiom Inv_def_r : forall x:int. infix_pl x (prefix_mn x) = zero

(* clone algebra.Group with type t2 = int, function inv = prefix_mn,
