elpi: success
theory Task

type int

type real

type string

predicate infix_eq 'a 'a

(* use why3.BuiltIn.BuiltIn *)

type bool =
  | True
  | False

(* use why3.Bool.Bool *)

type tuple0 =
  | Tuple0 [@builtin]

(* use why3.Tuple0.Tuple01 *)

type unit [@builtin] = unit

(* use why3.Unit.Unit *)

type (->) 'a 'b

function infix_at ('a -> 'b) 'a : 'b

(* use why3.HighOrd.HighOrd *)

type eq [@class] 'a =
  | Eqqtmk [@builtin] (equ:'a -> 'a -> bool)

(* meta model_record function equ *)

constant bool_eq [@instance] : eq bool =
  Eqqtmk
  (fun (a:bool) (b:bool) ->
    ([@asym_split] ([@asym_split] a = True) && b = True) ||
    ([@asym_split] not a = True) && not b = True)

constant int_eq [@instance] : eq int = Eqqtmk (fun (a:int) (b:int) -> a = b)

type tuple2 'a 'a1 =
  | Tuple2 [@builtin] 'a 'a1

(* use why3.Tuple2.Tuple21 *)

function pair_eq [@instance] (f1:eq 'a) (f2:eq 'b) : eq ('a, 'b) =
  Eqqtmk
  (fun (a:('a, 'b)) (b:('a, 'b)) ->
    match a with
    | a1, a2 ->
        match b with
        | b1, b2 ->
            ([@asym_split] infix_at (infix_at (f1.equ) a1) b1 = True) &&
            infix_at (infix_at (f2.equ) a2) b2 = True
        end
    end)

(* meta syntax_type type int, "int", 0 *)

(* meta syntax_type type real, "real", 0 *)

(* meta syntax_logic predicate infix_eq, "(%1 = %2)", 0 *)

(* meta encoding:ignore_polymorphism_ls predicate infix_eq *)

goal test_tc :
  exists i:eq (int, bool).
   infix_at (infix_at (i.equ) (1, True)) (1, True) = True

end
