axiom tata [@useraxiom] : forall us:b. forall us1:a 'a. true

constant foo1 : (a 'a, a 'a) -> (a 'a, a 'a) -> bool =
  fun (us:(a 'a, a 'a)) (us1:(a 'a, a 'a)) -> True

