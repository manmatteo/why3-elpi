% Structural witness synthesis for eq/ord records.
% Unlike tc.elpi, this example does not inspect [@instance] declarations.
% Instead it derives witnesses from the requested type shape by following
% helper combinator signatures already present in the Why3 task.

w3_run Rest (goal-formula GoalPr Goal) [focused-task Rest (goal-formula GoalPr GoalOut)] :-
  solve-derive Rest Goal GoalOut.

w3_derive_eq Rest (goal-formula GoalPr Goal) [focused-task Rest (goal-formula GoalPr GoalOut)] :-
  solve-derive-family "eq" Rest Goal GoalOut.

w3_derive_ord Rest (goal-formula GoalPr Goal) [focused-task Rest (goal-formula GoalPr GoalOut)] :-
  solve-derive-family "ord" Rest Goal GoalOut.

pred solve-derive i:list tdecl, i:term, o:term.
solve-derive Rest (tattr Attrs T) (tattr Attrs Out) :-
  solve-derive Rest T Out.
solve-derive Rest (ttrigger Triggers T) (ttrigger Triggers Out) :-
  solve-derive Rest T Out.
solve-derive Rest (tquant texists V Bnd) (tlet Witness V (x\ Body x)) :-
  why3.var-type V (tyapp DictTySym [TargetTy]),
  supported-dict-family DictTySym,
  derive-dict-term Rest DictTySym TargetTy Witness,
  (pi X\ ctx-vs X V => (
    solve-derive Rest (Bnd X) (Body X))).
solve-derive Rest (tquant texists V Bnd) (tquant texists V (x\ Body x)) :-
  (pi X\ ctx-vs X V => (
    solve-derive Rest (Bnd X) (Body X))).
solve-derive _ Goal Goal.

pred solve-derive-family i:string, i:list tdecl, i:term, o:term.
solve-derive-family Family Rest (tattr Attrs T) (tattr Attrs Out) :-
  solve-derive-family Family Rest T Out.
solve-derive-family Family Rest (ttrigger Triggers T) (ttrigger Triggers Out) :-
  solve-derive-family Family Rest T Out.
solve-derive-family Family Rest (tquant texists V Bnd) (tlet Witness V (x\ Body x)) :-
  why3.var-type V (tyapp DictTySym [TargetTy]),
  why3.tysymbol-name DictTySym Family,
  derive-dict-term Rest DictTySym TargetTy Witness,
  (pi X\ ctx-vs X V => (
    solve-derive-family Family Rest (Bnd X) (Body X))).
solve-derive-family Family Rest (tquant texists V Bnd) (tquant texists V (x\ Body x)) :-
  (pi X\ ctx-vs X V => (
    solve-derive-family Family Rest (Bnd X) (Body X))).
solve-derive-family _ _ Goal Goal.

pred supported-dict-family i:tysymbol.
supported-dict-family DictTySym :-
  why3.tysymbol-name DictTySym "eq".
supported-dict-family DictTySym :-
  why3.tysymbol-name DictTySym "ord".

pred derive-dict-term i:list tdecl, i:tysymbol, i:ty, o:term.
derive-dict-term Rest DictTySym (tyapp _TySym [] as TargetTy) (tapp Ls [] none) :-
  direct-ground-builder Rest DictTySym TargetTy Ls.
derive-dict-term Rest DictTySym (tyapp _TySym [ArgTy] as TargetTy) (tapp Ls [ArgWitness] none) :-
  derive-dict-term Rest DictTySym ArgTy ArgWitness,
  unary-builder Rest DictTySym ArgTy TargetTy Ls.
derive-dict-term Rest DictTySym (tyapp _TySym [Ty1, Ty2] as TargetTy) (tapp Ls [Arg1, Arg2] none) :-
  derive-dict-term Rest DictTySym Ty1 Arg1,
  derive-dict-term Rest DictTySym Ty2 Arg2,
  binary-builder Rest DictTySym Ty1 Ty2 TargetTy Ls.
derive-dict-term _ DictTySym Ty _ :-
  why3.tysymbol-name DictTySym DictName,
  print "cannot derive" DictName "for" Ty,
  fail.

pred direct-ground-builder i:list tdecl, i:tysymbol, i:ty, o:lsymbol.
direct-ground-builder Rest DictTySym TargetTy Ls :-
  available-logic-symbol Rest Ls (tyapp DictTySym [TargetTy]).

pred unary-builder i:list tdecl, i:tysymbol, i:ty, i:ty, o:lsymbol.
unary-builder Rest DictTySym ArgTy TargetTy Ls :-
  available-logic-symbol Rest Ls FullTy,
  instantiate-builder-type FullTy (tyapp DictTySym [TargetTy]) [ArgDictTy],
  ArgDictTy = tyapp DictTySym [ArgTy].

pred binary-builder i:list tdecl, i:tysymbol, i:ty, i:ty, i:ty, o:lsymbol.
binary-builder Rest DictTySym Ty1 Ty2 TargetTy Ls :-
  available-logic-symbol Rest Ls FullTy,
  instantiate-builder-type FullTy (tyapp DictTySym [TargetTy]) [ArgDictTy1, ArgDictTy2],
  ArgDictTy1 = tyapp DictTySym [Ty1],
  ArgDictTy2 = tyapp DictTySym [Ty2].

pred instantiate-builder-type i:ty, i:ty, o:list ty.
instantiate-builder-type (tyabs _Name TyF) QueryTy ArgTys :-
  sigma TyArg\ instantiate-builder-type (TyF TyArg) QueryTy ArgTys.
instantiate-builder-type (tyapp arr [ArgTy, RestTy]) QueryTy [ArgTy | ArgTys] :-
  instantiate-builder-type RestTy QueryTy ArgTys.
instantiate-builder-type QueryTy QueryTy [].

pred available-logic-symbol i:list tdecl, o:lsymbol, o:ty.
available-logic-symbol Rest Ls FullTy :-
  std.mem Rest (decl D),
  why3.decl-defines D Refs,
  std.mem Refs (gls Ls),
  why3.ls-full-type Ls FullTy.