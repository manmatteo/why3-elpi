% Structural witness synthesis for eq/ord records.
% Unlike tc.elpi, this example does not inspect [@instance] declarations.
% Instead it derives witnesses from the requested type shape by following
% helper combinator signatures already present in the Why3 task, looked up
% through the context clauses loaded by why3.with-context.

w3_run Rest (goal-formula GoalPr Goal) [focused-task Rest (goal-formula GoalPr GoalOut)] :-
  why3.with-context Rest (solve-derive Goal GoalOut).

w3_run Rest Goal [focused-task Rest Goal].

pred solve-derive i:term, o:term.
solve-derive (tattr Attrs T) (tattr Attrs Out) :-
  solve-derive T Out.
solve-derive (ttrigger Triggers T) (ttrigger Triggers Out) :-
  solve-derive T Out.
solve-derive (tquant texists V Bnd) (tlet Witness V (x\ Body x)) :-
  why3.var-type V (tyapp DictTySym [TargetTy]),
  supported-dict-family DictTySym,
  derive-dict-term DictTySym TargetTy Witness,
  (pi X\ ctx-vs X V => (
    solve-derive (Bnd X) (Body X))).
solve-derive (tquant texists V Bnd) (tquant texists V (x\ Body x)) :-
  (pi X\ ctx-vs X V => (
    solve-derive (Bnd X) (Body X))).
solve-derive Goal Goal.

pred supported-dict-family i:tysymbol.
supported-dict-family DictTySym :-
  why3.tysymbol-name DictTySym "eq".
supported-dict-family DictTySym :-
  why3.tysymbol-name DictTySym "ord".

pred derive-dict-term i:tysymbol, i:ty, o:term.
derive-dict-term DictTySym (tyapp _TySym [] as TargetTy) (tapp Ls [] none) :-
  direct-ground-builder DictTySym TargetTy Ls.
derive-dict-term DictTySym (tyapp _TySym [ArgTy] as TargetTy) (tapp Ls [ArgWitness] none) :-
  derive-dict-term DictTySym ArgTy ArgWitness,
  unary-builder DictTySym ArgTy TargetTy Ls.
derive-dict-term DictTySym (tyapp _TySym [Ty1, Ty2] as TargetTy) (tapp Ls [Arg1, Arg2] none) :-
  derive-dict-term DictTySym Ty1 Arg1,
  derive-dict-term DictTySym Ty2 Arg2,
  binary-builder DictTySym Ty1 Ty2 TargetTy Ls.
derive-dict-term DictTySym Ty _ :-
  why3.tysymbol-name DictTySym DictName,
  print "cannot derive" DictName "for" Ty,
  fail.

pred direct-ground-builder i:tysymbol, i:ty, o:lsymbol.
direct-ground-builder DictTySym TargetTy Ls :-
  available-logic-symbol Ls (tyapp DictTySym [TargetTy]).

pred unary-builder i:tysymbol, i:ty, i:ty, o:lsymbol.
unary-builder DictTySym ArgTy TargetTy Ls :-
  available-logic-symbol Ls FullTy,
  instantiate-builder-type FullTy (tyapp DictTySym [TargetTy]) [ArgDictTy],
  ArgDictTy = tyapp DictTySym [ArgTy].

pred binary-builder i:tysymbol, i:ty, i:ty, i:ty, o:lsymbol.
binary-builder DictTySym Ty1 Ty2 TargetTy Ls :-
  available-logic-symbol Ls FullTy,
  instantiate-builder-type FullTy (tyapp DictTySym [TargetTy]) [ArgDictTy1, ArgDictTy2],
  ArgDictTy1 = tyapp DictTySym [Ty1],
  ArgDictTy2 = tyapp DictTySym [Ty2].

pred instantiate-builder-type i:ty, i:ty, o:list ty.
instantiate-builder-type (tyabs _Name TyF) QueryTy ArgTys :-
  sigma TyArg\ instantiate-builder-type (TyF TyArg) QueryTy ArgTys.
instantiate-builder-type (tyapp arr [ArgTy, RestTy]) QueryTy [ArgTy | ArgTys] :-
  instantiate-builder-type RestTy QueryTy ArgTys.
instantiate-builder-type QueryTy QueryTy [].

pred available-logic-symbol o:lsymbol, o:ty.
available-logic-symbol Ls FullTy :-
  why3.defines (gls Ls) _,
  why3.ls-full-type Ls FullTy.
