% Simplified version of Why3's split_goal transform:
% split only top-level conjunctions in the goal into independent subgoals.

w3_run Rest (goal-formula GoalPr Goal) Tasks :-
  flatten-and Goal Terms,
  std.map Terms (g\ t\ t = focused-task Rest (goal-formula GoalPr g)) Tasks.

w3_run Rest Goal [focused-task Rest Goal].

% Dispatch on the total why3.as-and classifier: conjunctions are flattened,
% any other formula is a leaf. some/none are disjoint patterns.
func flatten-and term -> list term.
flatten-and T Out :- why3.as-and T Conj, flatten-step T Conj Out.

func flatten-step term, option (pair term term) -> list term.
flatten-step _ (some (pr A B)) Out :-
  flatten-and A LA,
  flatten-and B LB,
  std.append LA LB Out.
flatten-step T none [T].
