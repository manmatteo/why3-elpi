% Instantiate the top-level existential in the goal with an explicit witness.
%
% This is a small proof point for typed term arguments passed through Why3's
% Args_wrapper machinery before entering ELPI.

w3_run Witness Rest Goal [focused-task Rest GoalOut] :-
  why3.goal-conclusion Goal _GoalPr Conclusion,
  instantiate-exists Witness Conclusion ConclusionOut,
  why3.set-conclusion Goal ConclusionOut GoalOut.

w3_run _ Rest Goal [focused-task Rest Goal].

% The attribute and trigger wrappers of the conclusion are preserved around
% the instantiated body, so this recursion is written on the raw term
% constructors; the three clause heads are disjoint.
func instantiate-exists term, term -> term.
instantiate-exists Witness (tattr Attrs Goal) (tattr Attrs GoalOut) :-
  instantiate-exists Witness Goal GoalOut.
instantiate-exists Witness (ttrigger Triggers Goal) (ttrigger Triggers GoalOut) :-
  instantiate-exists Witness Goal GoalOut.
instantiate-exists Witness (tquant texists _V Bnd) (Bnd Witness).
