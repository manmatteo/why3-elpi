% Compile [@class] and [@instance] declarations into a witness-synthesis
% engine for existential goals. Classes and instances are recognised through
% the context clauses loaded by why3.with-context; the task prefix is walked
% structurally and one compiled tc-inst clause is loaded per instance before
% solving the goal — no solution collection (findall) is involved.

w3_run Rest (goal-formula GoalPr GoalTerm) [focused-task Rest (goal-formula GoalPr FullInstance)] :-
  why3.with-context Rest (
    load-instances Rest (solve-tc GoalTerm FullInstance _ComputedInstances)).

w3_run Rest Goal [focused-task Rest Goal].

% Walk the task prefix and load one compiled tc-inst clause per [@instance]
% declaration, then run the continuation. The two cons clauses are disjoint
% through the none/some dispatch of tdecl-instance, which is a total
% function on task declarations.
pred load-instances i:list tdecl, i:prop.
load-instances [] K :- K.
load-instances [TD | Rest] K :-
  tdecl-instance TD none,
  load-instances Rest K.
load-instances [TD | Rest] K :-
  tdecl-instance TD (some Ls),
  compile-instance Ls C,
  C => load-instances Rest K.

% [tdecl-instance TD O] O is (some Ls) when TD defines the logic symbol Ls
% carrying an [@instance] attribute, and none otherwise.
pred tdecl-instance i:tdecl, o:option lsymbol.
tdecl-instance (decl D) O :- why3.decl-kind D K, kind-instance K D O.
tdecl-instance (use _) none.
tdecl-instance (meta _ _) none.
tdecl-instance (clone _) none.

pred kind-instance i:decl-kind, i:decl, o:option lsymbol.
kind-instance decl-logic D O :-
  why3.decl-defines D Refs,
  first-gls Refs Ls,
  why3.ls-attrs Ls Attrs,
  why3.has-attr Attrs "instance" B,
  instance-when B Ls O.
kind-instance decl-prop _ none.
kind-instance decl-type _ none.
kind-instance decl-data _ none.
kind-instance decl-ind _ none.
kind-instance decl-param _ none.

func first-gls list gref -> lsymbol.
first-gls [gls Ls | _] Ls.
first-gls [gpr _ | Refs] Ls :- first-gls Refs Ls.
first-gls [gty _ | Refs] Ls :- first-gls Refs Ls.

func instance-when bool, lsymbol -> option lsymbol.
instance-when tt Ls (some Ls).
instance-when ff _ none.

pred solve-tc i:term, o:term, o:list tdecl.
solve-tc (tattr _ T) FullInstance Rest :- solve-tc T FullInstance Rest.
solve-tc (ttrigger _ T) FullInstance Rest :- solve-tc T FullInstance Rest.
solve-tc (tquant texists VName Bnd) FullInstance Rest :-
  why3.var-type VName (tyapp TySym R),
  Ty = tyapp TySym R,
  is-class-ty TySym,
  print "query: tc-inst" Ty Tm,
  ( (pi X Y\ tc-inst X Y :- print "tc-inst" X, fail) =>
  tc-inst Ty Tm),
  print "yay",
  (pi X\ ctx-vs X VName => (
    solve-tc (Bnd X) (FullBody X) Rest)),
  FullInstance = tlet Tm VName (x\ FullBody x).
solve-tc A A [].

% [is-class-ty Ts] The task declares the algebraic type Ts with a [@class]
% attribute.
pred is-class-ty i:tysymbol.
is-class-ty TySym :-
  why3.datatype TySym _,
  why3.tysymbol-attrs TySym Attrs,
  why3.has-attr Attrs "class" tt.

pred compile-instance i:lsymbol, o:prop.
compile-instance LS P :-
  why3.ls-full-type LS Ty,
  compile-aux Ty LS [] true P,
  print "compiled" Ty "to" P.

pred compile-aux i:ty, i:lsymbol, i:list term, i:prop, o:prop.
pred tc-inst i:ty, o:term.
compile-aux (tyabs _Name TyF) LS ArgsTm Body (pi TyArg\ Cl TyArg) :-
  (pi TyArg\
    compile-aux (TyF TyArg) LS ArgsTm Body (Cl TyArg)).
compile-aux (tyapp arr [Ty1, Ty2]) LS ArgsTm Body (pi Inst\ Cl Inst) :-
  (pi Inst\ sigma ArgsTm1\
    std.append ArgsTm [Inst] ArgsTm1,
    compile-aux Ty2 LS ArgsTm1 (tc-inst Ty1 Inst, Body) (Cl Inst)).
compile-aux Head LS ArgsTm Body ((tc-inst Head (tapp LS ArgsTm none)) :- Body).
