w3_transform "rebuild-case" Rest (goal-formula GoalPr Goal)
  [focused-task Rest (goal-formula GoalPr GoalOut)] :-
  rewrite-term Goal GoalOut.

w3_transform _ Rest Goal [focused-task Rest Goal].

pred rewrite-term i:term, o:term.
pred rewrite-branch i:branch, o:branch.

rewrite-term (tattr Attrs T) (tattr Attrs T') :-
  rewrite-term T T'.
rewrite-term (tcase Scrut Branches) (tcase Scrut BranchesOut) :-
  std.map Branches rewrite-branch BranchesOut.
rewrite-term T T.

rewrite-branch (babs V Bnd) (babs V BndOut) :-
  (pi x\ ctx-vs x V =>
    rewrite-branch (Bnd x) (BndOut x)).
rewrite-branch (branch P Body) (branch P BodyOut) :-
  rewrite-term Body BodyOut.