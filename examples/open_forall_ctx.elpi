% Minimal experiment for opening Why3 quantifier binders.
%
% This deliberately avoids all the extra noise of `intros_full`: no implication
% handling. The point is to test the two ways of opening a binder:
%
% - why3.intro-var, which introduces a local constant for the bound variable
% - pi x\ ctx-vs x V => ..., which opens the binder with a fresh nominal
%   so that builtins (like the pretty printer) can be called on open terms
%
% We move under leading foralls, recurse on the opened body, then close the
% binder again. Dispatch goes through the total why3.as-forall classifier,
% so the clauses are disjoint by pattern matching on some/none.

w3_run Rest (goal-formula GoalPr Goal) [focused-task Rest GoalOut] :-
  rewrite-term Goal GoalTermOut,
  focus-term GoalPr Goal GoalOut,
  why3.pp-term GoalTermOut GoalStr,
  print "rewritten-goal" GoalStr.

w3_run Rest Goal [focused-task Rest Goal].

func focus-term prsymbol, term -> focused-goal.
focus-term GoalPr T GoalOut :-
  why3.as-forall T Fa,
  focus-step GoalPr Fa GoalOut.

func focus-step prsymbol, option (pair var (term -> term)) -> focused-goal.
focus-step GoalPr (some (pr V Bnd)) (Wrap Inner) :-
  why3.intro-var V Bnd Body Wrap,
  focus-term GoalPr Body Inner.
focus-step GoalPr none (goal-formula GoalPr ttrue).

% Body and BodyStr live under the pi: a clause-level variable could not
% capture the fresh nominal x, so the unification with the opened body
% would fail as soon as the body actually mentions x.
pred rewrite-term i:term, o:term.
rewrite-term T Out :-
  why3.as-forall T Fa,
  rewrite-step Fa Out.

pred rewrite-step i:option (pair var (term -> term)), o:term.
rewrite-step (some (pr V Bnd)) (tquant tforall V (x\ BodyOut x)) :-
  (pi x\ ctx-vs x V => sigma Body\ sigma BodyStr\ (
    Bnd x = Body,
    why3.pp-term Body BodyStr,
    print "open-body" BodyStr,
    rewrite-term Body (BodyOut x))).
rewrite-step none ttrue.
