% apply_ho: apply tactic using ELPI's higher-order unification over HOAS binders.
%
% This tactic peels forall binders by opening them with a fresh ELPI unification
% variable X per quantifier, and it also opens top-level let-binders by
% substituting their bound term through the body. ELPI's unification then
% instantiates X when the lemma conclusion is matched against the current goal.
% When no explicit witness is provided, premises already present as local
% hypotheses are discharged automatically.
%
% Example: lemma  nice_trans : forall x y. x <= y -> nice x -> nice y
%          goal   nice 3 -> nice 7
%   Matching the conclusion instantiates y = 7, then discharge-premises
%   matches "nice x" against hypothesis "nice 3" and leaves the subgoal 3 <= 7.
%
% Registered Why3 wrapper:  elpi_apply_ho <prop> [with] <term list>

w3_run Target WithTerms Decls Goal OutTasks :-
  focused-goal-shape Goal GoalPr GoalConclusion GoalHyps,
  find-lemma Decls Target LemmaT,
  peel-lemma LemmaT ForallVars LemmaPremises LemmaConclusion,
  LemmaConclusion = GoalConclusion,
  instantiate-with ForallVars WithTerms,
  discharge-premises LemmaPremises GoalHyps OpenPremises,
  std.map OpenPremises (p\ task\ sigma GoalOut\
    std.rev GoalHyps RevHyps,
    std.fold RevHyps (goal-formula GoalPr p) (h\ g\ r\ r = local-prop "hyp" h g) GoalOut,
    task = focused-task Decls GoalOut
  ) OutTasks.


w3_run _ _ Decls Goal [focused-task Decls Goal].
pred goal-shape i:term, o:term, o:list term.
goal-shape (tattr _ T) C Hs :- goal-shape T C Hs.
goal-shape (ttrigger _ T) C Hs :- goal-shape T C Hs.
goal-shape (tquant texists _ Bnd) C Hs :- goal-shape (Bnd X_) C Hs.
goal-shape (tlet T _ Bnd) C Hs :- goal-shape (Bnd T) C Hs.
goal-shape (tbinop timplies H Decls) C [H | Hs] :- !, goal-shape Decls C Hs.
goal-shape T T [].

pred focused-goal-shape i:focused-goal, o:prsymbol, o:term, o:list term.
focused-goal-shape (local-prop _ H Goal) Pr C [H | Hs] :-
  focused-goal-shape Goal Pr C Hs.
focused-goal-shape (goal-formula Pr T) Pr C Hs :-
  goal-shape T C Hs.

pred peel-lemma i:term, o:list term, o:list term, o:term.
peel-lemma (tattr _ T) Vs Ps C :- peel-lemma T Vs Ps C.
peel-lemma (ttrigger _ T) Vs Ps C :- peel-lemma T Vs Ps C.
peel-lemma (tlet T _ Bnd) Vs Ps C :- peel-lemma (Bnd T) Vs Ps C.
peel-lemma (tquant tforall _ Bnd) [X_ | Vs] Ps C :-
  !, peel-lemma (Bnd X_) Vs Ps C.
peel-lemma T [] Ps C :- peel-lemma-tail T Ps C.

pred peel-lemma-tail i:term, o:list term, o:term.
peel-lemma-tail (tattr _ T) Ps C :- peel-lemma-tail T Ps C.
peel-lemma-tail (ttrigger _ T) Ps C :- peel-lemma-tail T Ps C.
peel-lemma-tail (tlet T _ Bnd) Ps C :- peel-lemma-tail (Bnd T) Ps C.
peel-lemma-tail (tquant tforall _ Bnd) Ps C :- peel-lemma-tail (Bnd X_) Ps C.
peel-lemma-tail (tquant texists _ Bnd) Ps C :- peel-lemma-tail (Bnd X_) Ps C.
peel-lemma-tail (tbinop timplies P Tail) [P | Ps] C :-
  peel-lemma-tail Tail Ps C.
peel-lemma-tail C [] C.

pred instantiate-with i:list term, i:list term.
instantiate-with _ [].
instantiate-with [V | Vs] [T | Ts] :-
  V = T,
  !,
  instantiate-with Vs Ts.
instantiate-with [_ | Vs] Ts :-
  instantiate-with Vs Ts.

pred discharge-premises i:list term, i:list term, o:list term.
discharge-premises [] _ [].
discharge-premises [P | Ps] Hyps Out :-
  std.mem Hyps P,
  !,
  discharge-premises Ps Hyps Out.
discharge-premises [P | Ps] Hyps [P | Out] :-
  discharge-premises Ps Hyps Out.

pred find-lemma i:list tdecl, i:prsymbol, o:term.
find-lemma [decl D | _] Target T :-
  why3.decl-kind D decl-prop,
  why3.decl-defines D Refs,
  std.mem Refs (gpr Target),
  why3.decl-body D (gpr Target) (dterm T).
find-lemma [_ | Rest] Target T :- find-lemma Rest Target T.

