% Derive structural Why3 logical equality for algebraic datatypes via type introspection.
%
% Given a goal of the form
%
%   exists eq_foo : <type> -> <type> -> bool. P eq_foo
%
% where <type> is an algebraic type in the task declarations,
% this transform synthesizes a local logic function `eq_foo` by constructor
% case analysis,
% then continues solving the residual goal in a scope where `eq_foo` is in ctx-ls.
%
% This example demonstrates:
%   - Using why3.decl-data-constructors to introspect algebraic type definitions
%   - Using the focused-goal API to introduce a local logic symbol
%   - Structural term synthesis via dabs/dterm/tcase/branch

% Main transform: recognise exists goals and attempt synthesis
w3_run Rest (goal-formula GoalPr Goal) [focused-task Rest GoalOut] :-
  why3.with-context Rest (open-and-derive GoalPr Goal GoalOut).

% Fallback: no synthesis attempted
w3_run Rest Goal [focused-task Rest Goal].

% Recursively open forall/exists and attempt synthesis at the exists
pred open-and-derive i:prsymbol, i:term, o:focused-goal.

% Skip attributes and triggers
open-and-derive GoalPr (tattr _ T) GoalOut :-
  open-and-derive GoalPr T GoalOut.
open-and-derive GoalPr (ttrigger _ T) GoalOut :-
  open-and-derive GoalPr T GoalOut.

% Attempt synthesis on existential: check if it looks like a function type
open-and-derive GoalPr (tquant texists EqVar Bnd) (Wrap ContGoal) :-
  why3.var-type EqVar VarTy,
  % Extract the compared type from a function type (a -> a -> bool)
  extract-base-type-from-arrow VarTy FullBaseTy TySym,
  why3.datatype TySym DataDecl,
  why3.decl-data-constructors DataDecl Ctors,
  find-global-eq-symbol EqSym,
  % EqBody is an output of the synthesis below; the local definition can be
  % assembled before its body is known.
  why3.intro-def EqVar EqBody EqOcc Wrap,
  synth-eq-body-from-ctors FullBaseTy Ctors EqOcc EqSym EqBody,
  open-and-derive GoalPr (Bnd EqOcc) ContGoal.

% Skip forall and pass through
open-and-derive GoalPr (tquant tforall FVar Bnd) GoalOut :-
  GoalOut = goal-formula GoalPr (tquant tforall FVar Bnd).

% Skip non-matching exists and pass through
open-and-derive GoalPr (tquant texists V Bnd) GoalOut :-
  GoalOut = goal-formula GoalPr (tquant texists V Bnd).

% Fallback: leave goal unchanged
open-and-derive GoalPr Goal (goal-formula GoalPr Goal).

% Extract base argument type and its type symbol from a function type (a ->
% a -> bool gives a, sym). The clauses overlap on purpose: which argument
% type to pick is a relational choice, further constrained by the caller
% (the extracted symbol must have a datatype declaration in the context).
pred extract-base-type-from-arrow i:ty, o:ty, o:tysymbol.
extract-base-type-from-arrow (tyapp arr [tyapp TySym Args, _]) (tyapp TySym Args) TySym.
extract-base-type-from-arrow (tyapp arr [_, RestTy]) BaseTy TySym :-
  extract-base-type-from-arrow RestTy BaseTy TySym.

% Resolve the built-in logical equality symbol from the task context.
pred find-global-eq-symbol o:lsymbol.
find-global-eq-symbol EqSym :-
  why3.defines (gls EqSym) _,
  (why3.ls-name EqSym "(=)" ; why3.ls-name EqSym "infix_eq" ; why3.ls-name EqSym "infix =").

% Build argument types for a constructor, instantiating type parameters from BaseTy.
pred constructor-arg-types i:lsymbol, i:ty, o:list ty.
constructor-arg-types Ctor BaseTy ArgTys :-
  why3.ls-full-type Ctor FullTy,
  instantiate-constructor-type FullTy BaseTy ArgTys.

pred instantiate-constructor-type i:ty, i:ty, o:list ty.
instantiate-constructor-type (tyabs _Name TyF) BaseTy ArgTys :-
  sigma TyArg\ instantiate-constructor-type (TyF TyArg) BaseTy ArgTys.
instantiate-constructor-type (tyapp arr [ArgTy, RestTy]) BaseTy [ArgTy | ArgTys] :-
  instantiate-constructor-type RestTy BaseTy ArgTys.
instantiate-constructor-type BaseTy BaseTy [].

% Fields of the compared type recurse through the symbol being defined
% (the nonlinear head of the first clause requires the field type to be
% the compared type); the second clause offers the global equality as the
% general case, preferred second by clause order.
%
% Note: the recursive branch builds a well-formed application of the
% symbol being defined, but Why3 only accepts recursive logic definitions
% with a structural termination argument on the parameters of a
% first-order definition; the constant-with-lambda shape produced by
% symbol-logic has none, so a recursive datatype still fails at readback.
pred compare-field i:ty, i:term, i:lsymbol, i:ty, i:term, i:term, o:term.
compare-field BaseTy EqSelf _EqSym BaseTy X Y Cmp :-
  why3.app EqSelf X EqX,
  why3.app EqX Y Cmp.
compare-field _BaseTy _EqSelf EqSym _FieldTy X Y (tapp EqSym [X, Y] none).

pred mk-vars-from-types i:list ty, i:string, o:list var.
mk-vars-from-types [] _ [].
mk-vars-from-types [Ty | Tys] Prefix [V | Vs] :-
  why3.mk-var Prefix Ty V,
  mk-vars-from-types Tys Prefix Vs.

pred prepend-comparison i:term, i:branch, o:branch.
prepend-comparison Cmp (branch Pat Body) (branch Pat (tif Cmp Body tfalse)).
prepend-comparison Cmp (babs V Bnd) (babs V (v\ BndOut v)) :-
  (pi v\ ctx-vs v V =>
    prepend-comparison Cmp (Bnd v) (BndOut v)).

pred prepend-pattern-var i:var, i:branch, o:branch.
prepend-pattern-var V (branch (papp Ctor Pats) Body) (branch (papp Ctor [pvar V | Pats]) Body).
prepend-pattern-var V (babs W Bnd) (babs W (w\ BndOut w)) :-
  (pi w\ ctx-vs w W =>
    prepend-pattern-var V (Bnd w) (BndOut w)).

pred prepend-y-field i:ty, i:term, i:lsymbol, i:ty, i:term, i:var, i:branch, o:branch.
prepend-y-field BaseTy EqSelf EqSym FieldTy X YVar TailBranch (babs YVar (y\ BranchOut y)) :-
  (pi y\ ctx-vs y YVar =>
    (compare-field BaseTy EqSelf EqSym FieldTy X y Cmp,
     prepend-pattern-var YVar TailBranch TailWithPat,
     prepend-comparison Cmp TailWithPat (BranchOut y))).

pred prepend-field-open
  i:ty, i:term, i:lsymbol, i:ty, i:var, i:term, i:var, i:branch, o:branch.
prepend-field-open BaseTy EqSelf EqSym FieldTy XVar X YVar (babs V Bnd) (babs V (v\ BndOut v)) :-
  (pi v\ ctx-vs v V =>
    prepend-field-open BaseTy EqSelf EqSym FieldTy XVar X YVar (Bnd v) (BndOut v)).
prepend-field-open BaseTy EqSelf EqSym FieldTy XVar X YVar
  (branch (papp Ctor PatsX) (tcase BTerm [SameCtor, branch pwild tfalse]))
  (branch (papp Ctor [pvar XVar | PatsX]) (tcase BTerm [SameCtorOut, branch pwild tfalse])) :-
  prepend-y-field BaseTy EqSelf EqSym FieldTy X YVar SameCtor SameCtorOut.

pred prepend-field i:ty, i:term, i:lsymbol, i:ty, i:var, i:var, i:branch, o:branch.
prepend-field BaseTy EqSelf EqSym FieldTy XVar YVar TailBranch (babs XVar (x\ BranchOut x)) :-
  (pi x\ ctx-vs x XVar =>
    prepend-field-open BaseTy EqSelf EqSym FieldTy XVar x YVar TailBranch (BranchOut x)).

pred build-ctor-branch i:ty, i:term, i:lsymbol, i:term, i:lsymbol,
  i:list ty, i:list var, i:list var, o:branch.
build-ctor-branch _BaseTy _EqSelf _EqSym BTerm Ctor [] [] []
  (branch (papp Ctor []) (tcase BTerm [branch (papp Ctor []) ttrue, branch pwild tfalse])).
build-ctor-branch BaseTy EqSelf EqSym BTerm Ctor [FieldTy | FieldTys] [X | Xs] [Y | Ys] BranchOut :-
  build-ctor-branch BaseTy EqSelf EqSym BTerm Ctor FieldTys Xs Ys TailBranch,
  prepend-field BaseTy EqSelf EqSym FieldTy X Y TailBranch BranchOut.

pred synth-ctor-branches i:ty, i:term, i:lsymbol, i:term,
  i:list (pair lsymbol (list (option lsymbol))), o:list branch.
synth-ctor-branches BaseTy EqSelf EqSym BTerm Ctors Branches :-
  std.map Ctors (synth-one-ctor BaseTy EqSelf EqSym BTerm) Branches.

pred synth-one-ctor i:ty, i:term, i:lsymbol, i:term,
  i:pair lsymbol (list (option lsymbol)), o:branch.
synth-one-ctor BaseTy EqSelf EqSym BTerm (pr Ctor _Projs) Br :-
  constructor-arg-types Ctor BaseTy FieldTys,
  mk-vars-from-types FieldTys "x" XVars,
  mk-vars-from-types FieldTys "y" YVars,
  build-ctor-branch BaseTy EqSelf EqSym BTerm Ctor FieldTys XVars YVars Br.

% Synthesize: fun a b -> match a with ...
% EqSelf is the occurrence term of the symbol being defined.
pred synth-eq-body-from-ctors i:ty, i:list (pair lsymbol (list (option lsymbol))), i:term, i:lsymbol, o:decl_body.
synth-eq-body-from-ctors BaseTy Ctors EqSelf EqSym Body :-
  why3.mk-var "a" BaseTy Va,
  why3.mk-var "b" BaseTy Vb,
  (pi A\ ctx-vs A Va =>
    (pi B\ ctx-vs B Vb =>
      synth-ctor-branches BaseTy EqSelf EqSym B Ctors (Branches B))),
  Body = dabs Va (a\ dabs Vb (b\ dterm (tcase a (Branches b)))).
